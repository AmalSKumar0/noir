# ===================================================================
# Noir Frontend Environment Configuration
# Copy this file to .env and configure values for your environment.
# ===================================================================

# Public Frontend Base URL
# Used for self-referential links, installer scripts (install.sh / install.ps1),
# CLI download links, and OAuth callbacks.
APP_URL="https://noir.amalskumar.dev"
VITE_APP_URL="https://noir.amalskumar.dev"

# Backend API & WebSocket Base URL
# (e.g. https://api.amalskumar.dev or http://127.0.0.1:8000 for local dev)
VITE_API_BASE_URL="https://api.amalskumar.dev"

# GEMINI_API_KEY: Optional Gemini AI API key for intelligence capabilities
# GEMINI_API_KEY=""
